{
  "manifest_version": 3,
  "name": "WikiStyle",
  "version": "0.9.7",
  "description": "Personaliza la alineación y el color de fondo de elementos de Wikipedia.",
  "permissions": ["storage", "activeTab"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "WikiStyle",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.wikipedia.org/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.wikipedia.org/*"],
      "js": ["visual-editor.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
